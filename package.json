{
  "private": true,
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:kategengler/ember-cli-code-coverage.git"
  },
  "scripts": {
    "test": "vitest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@release-it-plugins/lerna-changelog": "^8.0.1",
    "@release-it-plugins/workspaces": "^5.0.3",
    "chai-files": "^1.4.0",
    "content-tag": "^4.1.0",
    "execa": "9.6.1",
    "fixturify-project": "~7.1.3",
    "fs-extra": "~11.3.3",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@10.29.3",
  "release-it": {
    "plugins": {
      "@release-it-plugins/workspaces": {
        "workspaces": [
          "packages/ember-cli-code-coverage"
        ]
      },
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md"
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    },
    "npm": false
  }
}