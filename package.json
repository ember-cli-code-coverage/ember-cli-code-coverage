{
  "private": true,
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:kategengler/ember-cli-code-coverage.git"
  },
  "scripts": {
    "test": "vitest",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "pnpm format",
    "lint:packages": "pnpm -r --if-present run lint",
    "lint:packages:fix": "pnpm -r --if-present run lint:fix"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@glimmer/syntax": "^0.95.0",
    "@release-it-plugins/lerna-changelog": "^9.0.0",
    "@release-it-plugins/workspaces": "^6.0.0",
    "concurrently": "^10.0.5",
    "content-tag": "^4.2.0",
    "execa": "^10.0.1",
    "fixturify-project": "~7.1.3",
    "fs-extra": "~11.4.0",
    "prettier": "^3.9.6",
    "release-it": "^19.2.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "release-it": {
    "plugins": {
      "@release-it-plugins/workspaces": {
        "workspaces": [
          "packages/ember-cli-code-coverage"
        ]
      },
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md"
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    },
    "npm": false
  }
}
