{
  "name": "ember-cli-code-coverage",
  "version": "4.0.0",
  "description": "Code coverage for Ember projects using Istanbul. Supports classic builds, Embroider, and Vite.",
  "keywords": [
    "ember-addon",
    "ember",
    "coverage",
    "istanbul",
    "vite",
    "testem",
    "babel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-cli-code-coverage/ember-cli-code-coverage",
    "directory": "packages/ember-cli-code-coverage"
  },
  "license": "MIT",
  "author": "Katie Gengler",
  "contributors": [
    "Matthew Dahl (https://github.com/sandersky)",
    "Robert Jackson (https://github.com/rwjblue)",
    "Robert Wagner (https://github.com/rwwagner90)"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "coverage-merge": "./bin/coverage-merge.js"
  },
  "files": [
    "addon-main.cjs",
    "bin",
    "glimmer-plugin.cjs",
    "dist",
    "_app_",
    "runtime",
    "src/babel/gjs-gts-istanbul-ignore-template-plugin.cjs",
    "src/babel/template-coverage-import-plugin.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./babel": {
      "types": "./dist/babel/index.d.ts",
      "default": "./dist/babel/index.js"
    },
    "./babel/template-coverage-import-plugin": "./src/babel/template-coverage-import-plugin.cjs",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./testem": {
      "types": "./dist/testem/index.d.ts",
      "default": "./dist/testem/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./merge": {
      "types": "./dist/merge/index.d.ts",
      "default": "./dist/merge/index.js"
    },
    "./test-support": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./glimmer": {
      "types": "./dist/glimmer/index.d.ts",
      "default": "./dist/glimmer/index.js"
    },
    "./helpers/*": "./runtime/helpers/*.js",
    "./_app_/*": "./_app_/*"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest",
    "lint:publish": "pnpm build && publint run --level error"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "babel-plugin-istanbul": "^8.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "publint": "^0.3.16",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./helpers/coverage-init.js": "./_app_/helpers/coverage-init.js",
      "./helpers/coverage-mark.js": "./_app_/helpers/coverage-mark.js",
      "./helpers/coverage-cond.js": "./_app_/helpers/coverage-cond.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    }
  }
}
